# =====================================================================
#  DCMA 14-Point Assessment — kontrol 1–5 (Logic and constraint shapes)
#  Sorumlu: Burak Sami Şirin · İkinci kişi: Eylem Sarıbal
# =====================================================================
#
#  Bu dosya ne yapar?
#    Her kontrol, kurala UYMAYAN her aktiviteyi veya bağlantıyı tek tek
#    işaretler (pySHACL raporunda bir "ihlal" = Findings sayfasında bir satır).
#    Oran hesabı (örn. "en fazla %5") burada YAPILMAZ; onu queries/ klasöründeki
#    SPARQL sorguları yapar (metrics/ratios.py çalıştırır). Ama EŞİKLER bu
#    dosyada durur (aşağıdaki "Eşikler" bölümü), böylece planlama mühendisi
#    kodu açmadan eşiği değiştirebilir (Story 5).
#
#  Kim sayılır? (DCMA 2012 / Mosaic WP1088)
#    - Aktivite kontrolleri (1, 5): türü "Task" olan ve tamamlanmamış aktiviteler.
#      Milestone, LOE, Summary ve tamamlanmış aktiviteler sayılmaz.
#    - Bağlantı kontrolleri (2, 3, 4): ardılı yukarıdaki gibi sayılan bir task
#      olan bağlantılar.
#
#  Neden SPARQL hedefi (sh:SPARQLTarget)?
#    sh:targetClass bir sınıfın TÜM üyelerini seçer; filtre koyamaz. Bize
#    "tür = Task VE durum != Completed" filtresi lazım, onu küçük bir SPARQL
#    sorgusuyla yazıyoruz. Bu özellik SHACL Advanced Features'ta, yani
#    pySHACL'ı MUTLAKA advanced modda çalıştırmak gerekir:
#        pyshacl -a -s shapes/dcma_1_5.ttl <veri.ttl>
#    -a olmadan hedefler sessizce boş kalır ve her şey "Conforms: True" çıkar!
#
#  Değerler büyük/küçük harfe duyarsız karşılaştırılır (LCASE), çünkü
#  şablondan "Task", "task", "Completed", "Complete" gibi farklı yazımlar gelebilir.
# =====================================================================

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix sched: <http://example.org/schedule#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# SPARQL sorgularının içinde "sched:" kısaltmasını kullanabilmek için
# prefix'i burada tanıtıyoruz. Her SPARQL hedefi sh:prefixes ile buna bağlanır.
sched:DcmaPrefixes
    sh:declare [
        sh:prefix    "sched" ;
        sh:namespace "http://example.org/schedule#"^^xsd:anyURI ;
    ] .


# ---------------------------------------------------------------------
#  Eşikler (planlama mühendisi BURAYI değiştirebilir)
#
#  Her kontrol için bir sched:Check düğümü. Bunlar SHACL shape'i DEĞİL;
#  pySHACL onları görmezden gelir. metrics/ratios.py bu düğümleri okur,
#  sched:ratioQuery'deki SPARQL dosyasını çalıştırır ve sonucu eşikle
#  karşılaştırır.
#
#    sched:thresholdPercent  eşik, YÜZDE olarak (5.0 = %5)
#    sched:comparison        "<=" -> oran eşikten küçük/eşitse geçer
#                            ">=" -> oran eşikten büyük/eşitse geçer
#    sched:ratioQuery        queries/ klasöründeki sorgu dosyasının adı
#    sched:countingRule      rapordaki "Method" sayfası için sayım kuralı
# ---------------------------------------------------------------------
sched:Check1 a sched:Check ;
    sched:checkNumber 1 ;
    sched:checkName "Logic" ;
    sched:thresholdPercent 5.0 ;
    sched:comparison "<=" ;
    sched:ratioQuery "check1_logic.rq" ;
    sched:countingRule "Incomplete tasks missing a predecessor or a successor, divided by all incomplete tasks (milestones, level of effort, summaries and completed activities excluded)." .

sched:Check2 a sched:Check ;
    sched:checkNumber 2 ;
    sched:checkName "Leads" ;
    sched:thresholdPercent 0.0 ;
    sched:comparison "<=" ;
    sched:ratioQuery "check2_leads.rq" ;
    sched:countingRule "Relationships with a negative lag, divided by all relationships whose successor is an incomplete task." .

sched:Check3 a sched:Check ;
    sched:checkNumber 3 ;
    sched:checkName "Lags" ;
    sched:thresholdPercent 5.0 ;
    sched:comparison "<=" ;
    sched:ratioQuery "check3_lags.rq" ;
    sched:countingRule "Relationships with a positive lag, divided by all relationships whose successor is an incomplete task." .

sched:Check4 a sched:Check ;
    sched:checkNumber 4 ;
    sched:checkName "Relationship types" ;
    sched:thresholdPercent 90.0 ;
    sched:comparison ">=" ;
    sched:ratioQuery "check4_relationship_types.rq" ;
    sched:countingRule "Finish-to-Start relationships, divided by all relationships whose successor is an incomplete task." .

sched:Check5 a sched:Check ;
    sched:checkNumber 5 ;
    sched:checkName "Hard constraints" ;
    sched:thresholdPercent 5.0 ;
    sched:comparison "<=" ;
    sched:ratioQuery "check5_hard_constraints.rq" ;
    sched:countingRule "Incomplete tasks with a hard constraint (Must Start On, Must Finish On, Start No Later Than, Finish No Later Than, Mandatory Start, Mandatory Finish), divided by all incomplete tasks." .


# ---------------------------------------------------------------------
#  Kontrol 1 — Logic
#  Kural : Sayılan her task'ın en az bir öncülü VE en az bir ardılı olmalı.
#  Eşik  : hatalı task / sayılan task  <= %5   (oran SPARQL'da hesaplanacak)
#
#  Aktivite kendi öncülünü/ardılını bilmez; bu bilgi bağlantılarda durur.
#  Bu yüzden TERS YOL kullanıyoruz:
#    "öncülü var mı?"  = bu aktiviteyi successor olarak gösteren bağlantı var mı?
#                        -> [ sh:inversePath sched:successor ]
#    "ardılı var mı?"  = bu aktiviteyi predecessor olarak gösteren bağlantı var mı?
#                        -> [ sh:inversePath sched:predecessor ]
# ---------------------------------------------------------------------
sched:Check1_LogicShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes sched:DcmaPrefixes ;
        sh:select """
            SELECT ?this WHERE {
                ?this a sched:Activity ;
                      sched:activityType ?type ;
                      sched:status ?status .
                FILTER (LCASE(STR(?type)) = "task")
                FILTER (LCASE(STR(?status)) NOT IN ("complete", "completed"))
            }
        """ ;
    ] ;
    sh:property sched:Check1_MissingPredecessor , sched:Check1_MissingSuccessor .

# Property shape'lere isim (IRI) veriyoruz: raporda "sh:sourceShape" olarak
# bu isim görünür, böylece bulgunun hangi kontrolden geldiğini anlarız.
sched:Check1_MissingPredecessor a sh:PropertyShape ;
    sh:path [ sh:inversePath sched:successor ] ;
    sh:minCount 1 ;
    sh:message "Check 1 (Logic): incomplete task has no predecessor." .

sched:Check1_MissingSuccessor a sh:PropertyShape ;
    sh:path [ sh:inversePath sched:predecessor ] ;
    sh:minCount 1 ;
    sh:message "Check 1 (Logic): incomplete task has no successor." .


# ---------------------------------------------------------------------
#  Kontrol 2, 3, 4 ortak hedefi: ardılı sayılan bir task olan bağlantılar.
#  Aynı SPARQL sorgusu üç kez yazılmasın diye hedefi bir kez tanımlayıp
#  (sched:CountedRelationshipTarget) üç shape'te de kullanıyoruz.
# ---------------------------------------------------------------------
sched:CountedRelationshipTarget a sh:SPARQLTarget ;
    sh:prefixes sched:DcmaPrefixes ;
    sh:select """
        SELECT ?this WHERE {
            ?this a sched:Relationship ;
                  sched:successor ?succ .
            ?succ sched:activityType ?type ;
                  sched:status ?status .
            FILTER (LCASE(STR(?type)) = "task")
            FILTER (LCASE(STR(?status)) NOT IN ("complete", "completed"))
        }
    """ .


# ---------------------------------------------------------------------
#  Kontrol 2 — Leads (negatif lag)
#  Kural : Lag negatif olamaz  ->  lag >= 0
#  Eşik  : 0 (tek bir lead bile kontrolü fail ettirir)
# ---------------------------------------------------------------------
sched:Check2_LeadsShape a sh:NodeShape ;
    sh:target sched:CountedRelationshipTarget ;
    sh:property sched:Check2_NegativeLag .

sched:Check2_NegativeLag a sh:PropertyShape ;
    sh:path sched:lag ;
    sh:minInclusive 0 ;
    sh:message "Check 2 (Leads): relationship has a negative lag (lead)." .


# ---------------------------------------------------------------------
#  Kontrol 3 — Lags (pozitif lag)
#  Kural : Lag pozitif olmamalı  ->  lag <= 0
#  Eşik  : lag'li bağlantı / sayılan bağlantı  <= %5
#  Not   : Negatif lag kontrol 2'nin konusu; burada sadece > 0 olanlar çıkar.
# ---------------------------------------------------------------------
sched:Check3_LagsShape a sh:NodeShape ;
    sh:target sched:CountedRelationshipTarget ;
    sh:property sched:Check3_PositiveLag .

sched:Check3_PositiveLag a sh:PropertyShape ;
    sh:path sched:lag ;
    sh:maxInclusive 0 ;
    sh:message "Check 3 (Lags): relationship has a positive lag." .


# ---------------------------------------------------------------------
#  Kontrol 4 — Relationship types
#  Kural : FS dışındaki her bağlantı (SS, FF, SF) bulgu olarak listelenir.
#  Eşik  : FS bağlantı / sayılan bağlantı  >= %90
#  sh:pattern "^FS$" = değerin METNİ tam olarak "FS" olmalı (regex).
#
#  Neden sh:in değil de sh:pattern?
#    sh:in değeri tipiyle birlikte karşılaştırır. Arda'nın mapper'ı metni
#    "FS"^^xsd:string olarak yazıyor; Turtle'daki ( "FS" ) ise tipsiz.
#    rdflib ikisini FARKLI sayıyor -> sh:in ile düz FS bağlantı bile
#    yanlışlıkla bulgu çıkıyordu. sh:pattern sadece metne bakar, tip
#    farkını umursamaz. (Test: test_mapper_gibi_xsd_string_yazilan_degerler)
# ---------------------------------------------------------------------
sched:Check4_RelationshipTypesShape a sh:NodeShape ;
    sh:target sched:CountedRelationshipTarget ;
    sh:property sched:Check4_NonFinishToStart .

sched:Check4_NonFinishToStart a sh:PropertyShape ;
    sh:path sched:relationshipType ;
    sh:pattern "^FS$" ;
    sh:message "Check 4 (Relationship types): relationship is not Finish-to-Start." .


# ---------------------------------------------------------------------
#  Kontrol 5 — Hard constraints
#  Kural : Sayılan task'ta sert (iki yönlü) kısıt olmamalı.
#  Eşik  : kısıtlı task / sayılan task  <= %5
#  Sert kısıt listesi (MS Project + P6 adları). Start/Finish No Earlier Than
#  gibi yumuşak kısıtlar listede YOK, onlar serbest.
#  sh:not [ sh:pattern "^(A|B|...)$" ] = değerin metni listedekilerden
#  HİÇBİRİ olamaz. ^ ve $ "tam eşleşme" demek; | "veya" demek.
#  sh:in yerine sh:pattern kullanma nedeni kontrol 4'teki notla aynı
#  (sh:in ile mapper'dan gelen A4 kısıtı hiç yakalanmıyordu!).
#  Değerler şablondan tam bu yazımla gelmeli -> Aysu ile netleşecek.
#  DİKKAT: Listeyi değiştirirsen queries/check5_hard_constraints.rq
#  içindeki aynı listeyi de değiştir (test_ratios.py ikisini karşılaştırır).
# ---------------------------------------------------------------------
sched:Check5_HardConstraintsShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:prefixes sched:DcmaPrefixes ;
        sh:select """
            SELECT ?this WHERE {
                ?this a sched:Activity ;
                      sched:activityType ?type ;
                      sched:status ?status .
                FILTER (LCASE(STR(?type)) = "task")
                FILTER (LCASE(STR(?status)) NOT IN ("complete", "completed"))
            }
        """ ;
    ] ;
    sh:property sched:Check5_HardConstraint .

sched:Check5_HardConstraint a sh:PropertyShape ;
    sh:path sched:constraintType ;
    sh:not [
        sh:pattern "^(Must Start On|Must Finish On|Start No Later Than|Finish No Later Than|Mandatory Start|Mandatory Finish)$"
    ] ;
    sh:message "Check 5 (Hard constraints): incomplete task has a hard constraint." .
